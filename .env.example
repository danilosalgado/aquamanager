# =========================================================
# AquaManager — Variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# Nunca commite o arquivo ".env" real.
# =========================================================

# ---- PostgreSQL ----
POSTGRES_DB=aquamanager
POSTGRES_USER=aquamanager
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# ---- Backend (Spring Boot) ----
SPRING_PROFILES_ACTIVE=docker
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/aquamanager
DB_USERNAME=aquamanager
DB_PASSWORD=change-me-strong-password

# JWT — gere segredos fortes (>= 256 bits) em produção, nunca reutilize os de exemplo
JWT_ACCESS_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_ISSUER=aquamanager

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Trial / Planos ----
TRIAL_DAYS=14

# ---- Pagamentos (Asaas) ----
# Deixe ASAAS_ENABLED=false para usar o MockPaymentGateway (nenhuma chave necessária)
ASAAS_ENABLED=false
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=replace-with-a-webhook-shared-secret

# ---- Pagamentos (Stripe) — gateway ativo do plano único (R$120/mês) ----
# Deixe STRIPE_ENABLED=false para usar o MockPaymentGateway (nenhuma chave necessária).
# 1. Crie uma conta em https://dashboard.stripe.com e pegue as chaves de TESTE em
#    Developers > API keys.
# 2. Crie o produto "AquaManager" com um Price recorrente mensal de R$120 em Products,
#    e copie o ID do Price (começa com "price_") para STRIPE_PRICE_ID.
# 3. Para testar webhooks localmente, use a Stripe CLI: `stripe listen --forward-to
#    localhost:8080/api/v1/billing/webhooks/stripe` — ela imprime o STRIPE_WEBHOOK_SECRET
#    a usar. Em produção, o secret vem do endpoint configurado em Developers > Webhooks.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---- E-mail ----
# Deixe EMAIL_ENABLED=false para usar o ConsoleEmailSender (loga o conteúdo do e-mail, sem SMTP)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@aquamanager.app

# ---- Frontend (Vite) ----
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
# URL pública do frontend, usada pelo backend para montar links de e-mail e o redirect pós-OAuth do Google
FRONTEND_BASE_URL=http://localhost:5173

# ---- Google Calendar (sincronização de eventos da Agenda) ----
# Deixe em branco para manter a sincronização com o Google Calendar desativada
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/integracoes/google/callback

# ---- Assistente de IA (Gemini) — recurso do plano Professional/Enterprise ----
# Deixe GEMINI_API_KEY em branco para o assistente responder "API Key não configurada".
# GEMINI_MODEL usa o alias "gemini-flash-latest", mantido pela própria Google e que sempre
# aponta para o modelo flash atual — mais resiliente que fixar uma versão datada, já que a
# Google descontinua/restringe modelos específicos periodicamente (ex.: gemini-1.5-flash saiu
# de linha; gemini-2.5-flash chegou a ficar indisponível para novas chaves de API). Se ainda
# assim o assistente responder "Erro ao contatar o assistente de IA.", teste outros nomes de
# modelo diretamente no endpoint generateContent (não apenas no ListModels, que pode listar
# modelos sem acesso real para sua chave):
# https://generativelanguage.googleapis.com/v1beta/models?key=SUA_CHAVE
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Previsão do tempo (OpenWeatherMap) ----
# Deixe em branco para o widget de clima do dashboard ficar indisponível
OPENWEATHERMAP_API_KEY=
